# 真实 LLM API 模式：设为 api，并仅在本地 .env 中填写密钥。
LLM_MODE=offline
# openai / responses / anthropic / gemini（工作台使用；旧 Prompt 对照脚本仍为 Chat Completions）
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
TAVILY_API_KEY=

# RAG 与 Agent 固定参数
CHUNK_SIZE=260
CHUNK_OVERLAP=40
EMBEDDING_DIMENSION=512
TOP_K=3
SIMILARITY_THRESHOLD=0.25
MAX_AGENT_STEPS=3
MEMORY_TURNS=6
